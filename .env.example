# Runtime
NODE_ENV=development
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/backend-ledger

# Product
APP_CURRENCY=THB
CORS_ORIGINS=http://localhost:3000

# Auth
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-value
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# System bootstrap user
SYSTEM_USER_EMAIL=system.demo@backend-ledger.local
SYSTEM_USER_PASSWORD=SystemPass123
SYSTEM_USER_NAME=Backend Ledger System

# Optional email notifications
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=
